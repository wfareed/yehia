# Copy this file to .env.local (for local dev) or configure these as
# environment variables in your Hostinger Node.js app settings (production).

# Long random string used to sign admin session cookies.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Used ONLY to create the first admin account the very first time the app
# runs (i.e. when data/admins.json does not exist yet). After that, log in
# and use "Change Password" in the admin panel — these env vars are ignored
# once data/admins.json has been created.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# SMTP settings used to send the Contact page form to the address configured
# in Admin > Contact Page (defaults to info@visionedge-eg.com).
# These can be the credentials for the info@visionedge-eg.com mailbox itself
# (check your Hostinger email/hosting panel for SMTP host/port), or any other
# mailbox you want the form to send through.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@visionedge-eg.com
SMTP_PASS=your-mailbox-password
# Optional: override the "From" address shown to recipients (defaults to SMTP_USER)
SMTP_FROM=info@visionedge-eg.com
